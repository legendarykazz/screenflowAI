{
  "name": "screenflow-ai",
  "version": "1.0.0",
  "description": "Premium Windows alternative to Screen Studio with AI editing, zoom, and exports",
  "author": "ScreenFlowAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/legendarykazz/screenflowAI.git"
  },
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:desktop": "vite build --mode desktop",
    "build:extension": "node scripts/build-extension.js",
    "build:platforms": "npm run build:web && npm run build:extension",
    "build": "npm run build:desktop && electron-builder --publish never",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --publish never",
    "release:win": "npm run build:desktop && electron-builder --win nsis --publish always",
    "vercel-build": "vite build",
    "health": "node scripts/health-check.js",
    "health:quick": "node scripts/health-check.js --skip-build",
    "test:call-load": "node scripts/call-load-check.js",
    "test:editor-export": "node scripts/editor-export-smoke.js",
    "start": "electron .",
    "dev:electron": "set SCREENFLOW_DEV_SERVER=1&& electron ."
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "livekit-client": "^2.20.2",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.screenflow.ai",
    "productName": "ScreenFlowAI",
    "compression": "normal",
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe"
    ],
    "files": [
      "dist/app/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ScreenFlowAI-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "legendarykazz",
      "repo": "screenflowAI"
    }
  }
}
